// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"  // <--- Crucial: set to postgresql
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  shopName    String
  ownerName   String?
  phone       String
  address     String?
  status      String      @default("PENDING") // PENDING, APPROVED
  totalItems  Int
  items       OrderItem[]

  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  productName   String
  variantDetail String
  qty           Int
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
}

model CatalogHotspot {
  id          String   @id @default(cuid())
  imageId     String   // e.g., "Hamza Trading Co(Pune) New_page-0004.jpg"
  name        String
  types       String[] // Stored as array
  sizes       String[]
  top         Float
  left        Float
  width       Float
  height      Float
  price       String?
  createdAt   DateTime @default(now())

  @@index([imageId])
}