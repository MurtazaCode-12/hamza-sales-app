// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("user") // "admin" | "user"
  avatar    String?
  email     String?  @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  ownerName String?
  phone     String
  address   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  orders    Order[]

  @@index([name])
  @@index([phone])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String?
  rate        Float?
  unit        String?  @default("Pcs")
  image       String?
  catalogPage String?
  types       String[] @default([])
  sizes       String[] @default([])
  aliases     String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([catalogPage])
}

model Order {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  shopName    String
  ownerName   String?
  phone       String
  address     String?
  status      String      @default("PENDING") // PENDING, APPROVED
  totalItems  Int
  totalAmount Float?      @default(0)
  invoiceUrl  String?
  items       OrderItem[]
  profileId   String?
  profile     Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([profileId])
  @@index([clientId])
}

model OrderItem {
  id            String  @id @default(cuid())
  productName   String
  variantDetail String
  qty           Int
  rate          Float?  @default(0)
  unit          String? @default("Pcs")
  totalPrice    Float?  @default(0)
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CatalogHotspot {
  id          String   @id @default(cuid())
  imageId     String   // e.g., "Hamza Trading Co(Pune) New_page-0004.jpg"
  name        String
  types       String[] // Stored as array
  sizes       String[]
  top         Float
  left        Float
  width       Float
  height      Float
  price       String?
  createdAt   DateTime @default(now())

  @@index([imageId])
}