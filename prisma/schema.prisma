// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"  // <--- Crucial: set to postgresql
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("user") // "admin" | "user"
  avatar    String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  shopName   String
  ownerName  String?
  phone      String
  address    String?
  status     String      @default("PENDING") // PENDING, APPROVED
  totalItems Int
  items      OrderItem[]
  profileId  String?
  profile    Profile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([profileId])
}

model OrderItem {
  id            String  @id @default(cuid())
  productName   String
  variantDetail String
  qty           Int
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
}

model CatalogHotspot {
  id          String   @id @default(cuid())
  imageId     String   // e.g., "Hamza Trading Co(Pune) New_page-0004.jpg"
  name        String
  types       String[] // Stored as array
  sizes       String[]
  top         Float
  left        Float
  width       Float
  height      Float
  price       String?
  createdAt   DateTime @default(now())

  @@index([imageId])
}